# Copy to deploy/.env or export before `docker compose -f deploy/docker-compose.yml up`
SESSION_SECRET=change-me-to-a-long-random-string
# Required: Clerk Backend API secret key (https://dashboard.clerk.com).
# Compose will not sign in without this — the API refuses to boot without it.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Required: Clerk publishable key, baked into the web bundle at BUILD time
# (docker compose build reads this as a build arg — see deploy/docker-compose.yml).
# The web image build fails loudly if this is unset; it is not a runtime var.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Recommended for production: PEM key for networkless Clerk JWT verification
# (without it, a Clerk outage surfaces to users as 401 instead of an outage).
# CLERK_JWT_KEY=your_clerk_jwt_key
# HOSTED_LIMITS=false
# RAW_EVENT_RETENTION_DAYS=30
# CORS_ORIGIN=https://app.example.com
